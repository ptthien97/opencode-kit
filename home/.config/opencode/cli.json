{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "orng"
  },
  "diffs": {
    "wrap": "word",
    "view": "auto",
    "tree": true,
    "single": true
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "hide",
    "markdown": "rendered",
    "grouping": "auto",
    "image_preview": true,
    "new_location": "inherit",
    "tps": true,
    "terminal": true,
    "verbosity": "low",
    "permissions": "prompt"
  },
  "animations": true,
  "tabs": {
    "enabled": false,
    "scope": "global",
    "layout": "vertical",
    "indicators": "status",
    "mode": "off"
  },
  "attention": {
    "enabled": true
  },
  "terminal": {
    "copy": "select"
  },
  "debug": {
    "devtools": false,
    "timing": false,
    "turn_tokens": false
  },
  "plugins": [
    "./herdr-opencode",
    "@prevalentware/opencode-goal-plugin",
    "__EXAMPLE_REPO__"
  ]
}
