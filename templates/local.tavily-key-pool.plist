<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.tavily-key-pool</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/node</string>
    <string>__HOME__/.config/opencode/tools/tavily-key-pool/node_modules/tsx/dist/cli.mjs</string>
    <string>__HOME__/.config/opencode/tools/tavily-key-pool/cli.ts</string>
    <string>serve-proxy</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__HOME__/.config/opencode/tools/tavily-key-pool</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>5</integer>
  <key>StandardOutPath</key>
  <string>__HOME__/.tavily-key-pool/logs/proxy.out.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME__/.tavily-key-pool/logs/proxy.err.log</string>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
